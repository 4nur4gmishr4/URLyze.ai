# Copy to .env and fill in real values. Never commit .env.

# Required — Postgres (Neon) connection string
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Required — Gemini API key (create in Google AI Studio). Rotate if ever leaked.
GEMINI_API_KEY=""

# Optional — comma-separated model fallback chain (first that returns valid output wins)
GEMINI_MODELS="gemini-2.5-flash,gemini-2.0-flash"

# Rate limiting. `upstash` requires the two UPSTASH_* vars; `memory` is local-dev only.
RATE_LIMITER="upstash"
RATE_LIMIT_MAX="20"
RATE_LIMIT_WINDOW_S="3600"

# Required when RATE_LIMITER="upstash" — create a free Upstash Redis database
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional — Google sign-in (Continue with Google). Add all three to enable it.
# Create an OAuth 2.0 Client ID in Google Cloud Console. Set the authorized
# redirect URI to https://your-domain/api/auth/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
